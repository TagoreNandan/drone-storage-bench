# Global Benchmark Settings
LOG_LEVEL=INFO
RANDOM_SEED=42
BENCHMARK_CONFIG_PATH=benchmark.yaml
RESULTS_DIR=./results

# PostgreSQL Control Plane (Control-plane reference database for JOIN benchmarking)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_DB=control_plane

# TimescaleDB
TIMESCALE_HOST=timescaledb
TIMESCALE_PORT=5433
TIMESCALE_USER=postgres
TIMESCALE_PASSWORD=timescale_dev_password
TIMESCALE_DB=drone_telemetry

# QuestDB
QUESTDB_HOST=questdb
QUESTDB_PORT_HTTP=9000
QUESTDB_PORT_PG=8812
QUESTDB_PORT_ILP=9009

# ClickHouse
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT_HTTP=8123
CLICKHOUSE_PORT_NATIVE=9000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse_dev_password
CLICKHOUSE_DB=drone_telemetry

# InfluxDB 3 (Edge / OSS / Serverless compatibility API)
INFLUXDB_HOST=influxdb
INFLUXDB_PORT=8086
INFLUXDB_TOKEN=influxdb_dev_token_very_long_string_here
INFLUXDB_ORG=drone_org
INFLUXDB_DATABASE=drone_telemetry


# MongoDB

MONGODB_HOST=monogdb
MONGODB_PORT=27017
MONGODB_USER=root
MONGODB_PASSWORD=mongodb_dev_password
MONGODB_DATABASE=drone_telemetry

# DynamoDB Local
DYNAMODB_ENDPOINT_URL=http://localhost:8000
DYNAMODB_REGION=us-east-1
DYNAMODB_ACCESS_KEY=dummy
DYNAMODB_SECRET_KEY=dummy
DYNAMODB_TABLE_NAME=drone_telemetry